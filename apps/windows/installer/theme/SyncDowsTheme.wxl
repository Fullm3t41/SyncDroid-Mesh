  <String Id="ConfirmCancelMessage">Cancel SyncDows setup?</String>
  <String Id="ExecuteUpgradeRelatedBundleMessage">Previous SyncDows version</String>
  <String Id="HelpHeader">Setup help</String>
  <String Id="HelpText">/install, /repair or /uninstall chooses the setup action. /passive shows progress without prompts. /quiet runs without a window. /log file.txt writes a setup log.</String>
  <String Id="HelpCloseButton">&amp;Close</String>
  <String Id="InstallLicenseLinkText"></String>
  <String Id="InstallAcceptCheckbox"></String>
