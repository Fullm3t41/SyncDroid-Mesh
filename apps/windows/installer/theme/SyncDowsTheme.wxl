  <String Id="LoadingHeader">Preparing SyncDows</String>
  <String Id="LoadingText">Checking the current installation and getting setup ready.</String>
  <String Id="InstallHeader">Install or update SyncDows</String>
  <String Id="InstallMessage">Update your existing installation or set up SyncDows on this PC. Updates keep your settings, paired devices and synced folders.</String>
